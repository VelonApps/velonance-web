# Public browser configuration, never put private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_STUDIO_ID=
VITE_BASE_PATH=/
# Optional reCAPTCHA v3 public site key (configure App Check before enforcing).
VITE_RECAPTCHA_SITE_KEY=
# Local emulator only; must be false in production.
VITE_USE_EMULATORS=false
